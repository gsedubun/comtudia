<template>
  <div class="page">
    <div class="topbar">
      <text class="brand">comtudia</text>
      <text class="ratio">{{ratioText}}</text>
    </div>

    <div class="ring-wrap">
      <stack class="ring-stack">
        <progress class="ring" type="arc" percent="{{progressPct}}" style="color: {{accent}};"></progress>
        <div class="ring-center">
          <text class="countdown" style="color: {{accent}};">{{countdown}}</text>
          <text class="phase" style="color: {{accent}};">{{phaseLabel}}</text>
        </div>
      </stack>
    </div>

    <div class="next">
      <div class="next-row">
        <text class="next-label">Next</text>
        <text class="next-time" style="color: {{accent}};">{{nextClock}}</text>
      </div>
      <text class="next-remain">in {{remainingLabel}}</text>
    </div>

    <div class="footer">
      <div class="pill" onclick="openSchedule">
        <text class="pill-text">Schedule</text>
      </div>
      <div class="pill" onclick="openSettings">
        <text class="pill-text">Settings</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import store from '../../common/store'
import plan from '../../common/plan'
import format from '../../common/format'

var FASTING = '#8AA2FF'
var EATING = '#3DD597'

export default {
  private: {
    plan: null,
    accent: FASTING,
    phaseLabel: 'Fasting',
    countdown: '0:00',
    remainingLabel: '0m',
    nextClock: '--:--',
    progressPct: 0,
    ratioText: '18:6'
  },

  onInit() {
    this.plan = plan.defaultPlan()
    this.timer = null
    this.visible = false
    this.refresh()
  },

  onShow() {
    this.visible = true
    var self = this
    store.load(function (p) {
      self.plan = p
      self.ratioText = format.ratio(p)
      self.refresh()
      if (self.visible) self.startTimer()
    })
  },

  onHide() {
    this.visible = false
    this.stopTimer()
  },

  onDestroy() {
    this.visible = false
    this.stopTimer()
  },

  startTimer() {
    this.stopTimer()
    var self = this
    this.timer = setInterval(function () {
      self.refresh()
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  refresh() {
    if (!this.plan || plan.validate(this.plan)) return
    var st = plan.compute(this.plan, new Date())
    var eating = st.phase === 'eating'
    this.accent = eating ? EATING : FASTING
    this.phaseLabel = eating ? 'Eating' : 'Fasting'
    this.countdown = format.countdownShort(st.remainingMs)
    this.remainingLabel = format.duration(st.remainingMs)
    this.nextClock = format.clock(st.phaseEnd)
    this.progressPct = Math.round(st.progress * 100)
  },

  openSchedule() {
    router.push({ uri: '/pages/schedule' })
  },

  openSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    padding: 6px 10px;
  }

  .topbar {
    width: 100%;
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
  }

  .ratio {
    font-size: 16px;
    font-weight: bold;
    color: #c8c8c8;
  }

  .ring-wrap {
    flex: 1;
    width: 100%;
    justify-content: center;
    align-items: center;
  }

  .ring-stack {
    width: 132px;
    height: 132px;
  }

  .ring {
    width: 132px;
    height: 132px;
    stroke-width: 9px;
    start-angle: 0deg;
    total-angle: 360deg;
    layer-color: #141414;
  }

  .ring-center {
    position: absolute;
    left: 0;
    top: 0;
    width: 132px;
    height: 132px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .countdown {
    font-size: 44px;
    font-weight: bold;
    text-align: center;
    lines: 1;
  }

  .phase {
    font-size: 16px;
    font-weight: bold;
    text-align: center;
    margin-top: 1px;
  }

  .next {
    width: 100%;
    height: 40px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .next-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .next-label {
    font-size: 16px;
    color: #c8c8c8;
    margin-right: 4px;
  }

  .next-time {
    font-size: 18px;
    font-weight: bold;
  }

  .next-remain {
    font-size: 15px;
    color: #c8c8c8;
    margin-top: 1px;
  }

  .footer {
    width: 100%;
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .pill {
    width: 70px;
    height: 28px;
    border-radius: 14px;
    background-color: #141414;
    justify-content: center;
    align-items: center;
  }

  .pill-text {
    font-size: 15px;
    color: #ffffff;
    text-align: center;
  }
</style>
