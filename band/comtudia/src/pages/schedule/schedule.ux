<template>
  <div class="page">
    <div class="topbar">
      <text class="back" onclick="goBack">&lt;</text>
      <text class="title">Schedule</text>
      <text class="edit" onclick="openSettings">Edit</text>
    </div>

    <text class="summary">{{summary}}</text>
    <text class="summary-sub">{{summarySub}}</text>

    <list class="meals">
      <list-item for="{{meals}}" class="row {{$item.cls}}" type="meal">
        <div class="row-inner">
          <div class="row-main">
            <div class="row-top">
              <text class="time" style="color: {{$item.timeColor}};">{{$item.time}}</text>
              <text class="tag" style="color: {{$item.tagColor}};">{{$item.tag}}</text>
            </div>
            <text class="dur">{{$item.dur}}</text>
          </div>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import store from '../../common/store'
import plan from '../../common/plan'
import format from '../../common/format'

var FASTING = '#8AA2FF'
var EATING = '#3DD597'
var MUTED = '#9A9A9A'

export default {
  private: {
    summary: 'Today · 18:6',
    summarySub: '3 meals from 12:00',
    meals: []
  },

  onInit() {
    this.plan = plan.defaultPlan()
    this.timer = null
    this.visible = false
    this.refresh()
  },

  onShow() {
    this.visible = true
    var self = this
    store.load(function (p) {
      self.plan = p
      self.refresh()
      if (self.visible) self.startTimer()
    })
  },

  onHide() {
    this.visible = false
    this.stopTimer()
  },

  onDestroy() {
    this.visible = false
    this.stopTimer()
  },

  startTimer() {
    this.stopTimer()
    var self = this
    this.timer = setInterval(function () {
      self.refresh()
    }, 15000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  refresh() {
    if (!this.plan || plan.validate(this.plan)) return

    var now = new Date()
    var st = plan.compute(this.plan, now)
    var day = st.currentMeal ? st.currentMeal.day : (st.nextMeal ? st.nextMeal.day : now)
    var slots = plan.slotsForDate(this.plan, day)
    var nowMs = now.getTime()
    var currentMs = st.currentMeal ? st.currentMeal.start.getTime() : -1
    var nextMs = st.nextMeal ? st.nextMeal.start.getTime() : -1
    var accent = st.phase === 'fasting' ? FASTING : EATING

    this.summary = format.dayName(day, now) + ' · ' + format.ratio(this.plan)
    this.summarySub = this.plan.meals + ' meals from ' +
      format.clockMinutes(this.plan.window_start_minutes)

    var rows = []
    for (var i = 0; i < slots.length; i++) {
      var slot = slots[i]
      var isNow = slot.start.getTime() === currentMs
      var isNext = slot.start.getTime() === nextMs
      var past = slot.end.getTime() <= nowMs
      var cls = ''
      var tag = ''
      var tagColor = '#000000'
      var timeColor = past ? MUTED : '#FFFFFF'

      if (isNow) {
        cls = 'row-now'
        tag = 'NOW'
        tagColor = EATING
        timeColor = EATING
      } else if (isNext) {
        cls = 'row-next'
        tag = 'NEXT'
        tagColor = accent
      }

      rows.push({
        time: format.range(slot.start, slot.end),
        dur: 'Meal ' + slot.index + ' · ' + format.minutesLabel(slot.duration_minutes) +
          (format.spansDays(slot.start, slot.end) ? ' +1d' : ''),
        cls: cls,
        tag: tag,
        tagColor: tagColor,
        timeColor: timeColor
      })
    }
    this.meals = rows
  },

  goBack() {
    router.back()
  },

  openSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
  .page {
    flex-direction: column;
    background-color: #000000;
    padding: 6px 10px;
  }

  .topbar {
    width: 100%;
    height: 28px;
    flex-direction: row;
    align-items: center;
  }

  .back {
    width: 24px;
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
  }

  .title {
    flex: 1;
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }

  .edit {
    width: 38px;
    font-size: 15px;
    font-weight: bold;
    color: #8AA2FF;
    text-align: right;
  }

  .summary {
    width: 100%;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 2px;
  }

  .summary-sub {
    width: 100%;
    font-size: 14px;
    color: #c8c8c8;
    margin-top: 1px;
    margin-bottom: 2px;
  }

  .meals {
    flex: 1;
    width: 100%;
  }

  .row {
    height: 42px;
    margin-bottom: 3px;
    border-radius: 8px;
    background-color: #0b0b0b;
  }

  .row-now {
    background-color: #0f2a20;
  }

  .row-next {
    background-color: #101a30;
  }

  .row-inner {
    flex: 1;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
  }

  .row-main {
    flex: 1;
    flex-direction: column;
    justify-content: center;
  }

  .row-top {
    width: 100%;
    flex-direction: row;
    align-items: center;
  }

  .time {
    flex: 1;
    font-size: 16px;
    font-weight: bold;
    lines: 1;
  }

  .dur {
    font-size: 13px;
    color: #a8a8a8;
    margin-top: 1px;
  }

  .tag {
    width: 34px;
    font-size: 13px;
    font-weight: bold;
    text-align: right;
  }
</style>
